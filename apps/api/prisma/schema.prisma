generator client {
  provider        = "prisma-client-js"
  // Wymagane przez `@prisma/client@5.22` żeby zaakceptować `adapter` w
  // konstruktorze (`new PrismaClient({ adapter })`). W 7.x driverAdapters
  // jest GA i flag jest no-op — bezpieczne w obu wersjach.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── LICENSE ──────────────────────────────────────────────────────────────────

model LicensePlan {
  id           Int          @id @default(autoincrement())
  code         String       @unique // starter | standard | pro
  name         String
  maxUnits     Int? // null = unlimited
  maxBuildings Int?
  maxAdmins    Int
  licenseKeys  LicenseKey[]

  @@map("license_plans")
}

model LicenseKey {
  id         String           @id @default(uuid())
  key        String           @unique
  planId     Int
  plan       LicensePlan      @relation(fields: [planId], references: [id])
  status     LicenseKeyStatus @default(ACTIVE)
  validUntil DateTime?
  createdAt  DateTime         @default(now())

  activatedBy Int?      @unique
  admin       Admin?    @relation(fields: [activatedBy], references: [id])
  activatedAt DateTime?

  @@map("license_keys")
}

enum LicenseKeyStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

// ─── ADMIN ────────────────────────────────────────────────────────────────────

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  licenseKey     LicenseKey?
  buildings      Building[]
  integrators    Integrator[]
  buildingAdmins BuildingAdmin[]
  concierges     Concierge[]

  @@map("admins")
}

// ─── INTEGRATORS ──────────────────────────────────────────────────────────────

model Integrator {
  id           Int      @id @default(autoincrement())
  adminId      Int
  admin        Admin    @relation(fields: [adminId], references: [id])
  name         String
  email        String   @unique
  /// Wyświetlane w karcie integratora w Sidebarze. Opcjonalne — solo-integratorzy
  /// mogą zostawić puste.
  company      String?
  passwordHash String
  /// Preferencje powiadomień — Sesja 3 Panel Integratora.
  /// Shape: { offlineAlerts, heartbeatDropAlerts, firmwareUpdates,
  ///          emailChannel, pushChannel, weeklySummary } — bool flags.
  /// JSON żeby uniknąć migracji przy każdej nowej preferencji.
  notificationPrefs Json?
  /// Sesja 6 — email change flow z weryfikacją.
  /// Gdy user zażąda zmiany emaila, wpisujemy go tutaj + token + TTL 24h.
  /// Po kliku w link weryfikacyjny → swap email + clear pending.
  pendingEmail            String?
  pendingEmailToken       String?  @unique
  pendingEmailExpiresAt   DateTime?
  /// Sesja 5 — audit log każdej operacji write integratora.
  auditLogs    IntegratorAuditLog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@map("integrators")
}

/// Sesja 5 Panel Integratora — audit log każdej operacji write.
/// Pokazywany w Settings → Historia operacji. Pomaga w:
///   • compliance (kto, kiedy, co zmienił)
///   • diagnostyka w razie incydentu („integrator A zrestartował Edge X 5 min temu")
///   • RODO (track-uje dostęp do urządzeń klienta)
///
/// Retention: na razie unlimited. Sesja 6+ doda cleanup cron > 90 dni.
model IntegratorAuditLog {
  id            BigInt   @id @default(autoincrement())
  integratorId  Int
  integrator    Integrator @relation(fields: [integratorId], references: [id], onDelete: Cascade)
  /// Kategoria akcji — enum-like string. Przykłady:
  ///   INTERCOM_CREATE, INTERCOM_UPDATE, INTERCOM_UNLINK
  ///   LPR_CREATE, LPR_UPDATE, LPR_UNLINK
  ///   EDGE_RELAY_TRIGGER, EDGE_RESTART, EDGE_DEEPLINK_GENERATE
  ///   PROFILE_UPDATE, NOTIFICATION_PREFS_UPDATE
  ///   LAN_SCAN, CONFIG_EXPORT
  action        String
  /// Typ zasobu którego dotyczy akcja — np. INTERCOM, LPR_CAMERA, EDGE, BUILDING.
  /// Pomocne przy filtrowaniu UI ale opcjonalne.
  targetType    String?
  /// ID zasobu jako string (universal — Int dla buildingu, CUID dla Edge).
  targetId      String?
  /// Building scope — używane do filtrowania per-property audit views.
  buildingId    Int?
  /// Dodatkowy kontekst: IP klienta, user-agent, params akcji, error message.
  meta          Json?
  createdAt     DateTime @default(now())

  @@index([integratorId, createdAt(sort: Desc)])
  @@index([buildingId, createdAt(sort: Desc)])
  @@map("integrator_audit_logs")
}

// ─── BUILDING ─────────────────────────────────────────────────────────────────

model Building {
  id         Int      @id @default(autoincrement())
  adminId    Int
  admin      Admin    @relation(fields: [adminId], references: [id])
  objectType String   @default("BUILDING") // BUILDING | HOUSING_ESTATE | MIXED_USE | CAMPUS | PARKING
  // 2026-06-02 (FAZA b): features per typ obiektu. Defaulty inicjalizowane per
  // objectType przy create. Strukturę zostawiamy open (JSON), żeby nowe flagi
  // można dodawać bez migracji. Patrz `apps/api/src/buildings/buildings.constants.ts`
  // (`BuildingFeatures`, `DEFAULT_FEATURES`).
  features   Json     @default("{}")
  // 2026-06-02 (FAZA e) — Permissions Matrix per role.
  // Shape: { ba: {feat_*:bool, ap_<id>:bool}, concierge: {...}, resident: {...} }
  // Niezdefiniowany klucz = backend `hasPermission` zwraca `true` (defense:
  // nie blokuj feature których integrator nie skonfigurował). Patrz
  // `apps/api/src/buildings/feature-permissions.constants.ts`.
  featurePermissions Json @default("{}")
  name       String
  address    String
  nip        String?
  regon      String?
  createdAt  DateTime @default(now())

  // Archiwizacja (soft delete)
  isArchived Boolean   @default(false)
  archivedAt DateTime?

  // Parametry ogólne
  numberOfFloors     Int?
  numberOfHouses     Int?
  hasElevator        Boolean @default(false)
  hasCctv            Boolean @default(false)
  hasLightingControl Boolean @default(false)
  hasEdgeAI          Boolean @default(false)
  hasEdge            Boolean @default(false)
  hasPhotovoltaics   Boolean @default(false)

  // Udogodnienia
  hasPool        Boolean @default(false)
  hasGym         Boolean @default(false)
  hasSauna       Boolean @default(false)
  hasPlayroom    Boolean @default(false)
  hasBanquetHall Boolean @default(false)
  hasLobby       Boolean @default(false)

  // Domofon
  hasIntercom          Boolean @default(false)
  intercomManufacturer String?
  intercomModel        String?
  entranceCount        Int?

  // System rozpoznawania tablic (LPR)
  hasLprSystem    Boolean @default(false)
  lprManufacturer String?
  lprModel        String?

  // Paczkomaty / obsługa paczek
  packageHandling String? // LOCKER | CONCIERGE | NONE

  // Branding (base64)
  logoBase64            String?
  backgroundImageBase64 String?

  unitTypes                UnitType[]
  units                    Unit[]
  residents                Resident[]
  stairwells               Stairwell[]
  lprCameras               LprCamera[]
  intercoms                BuildingIntercom[]
  notifications            Notification[]
  buildingAdminAssignments BuildingAdminAssignment[]
  concierges               Concierge[]
  parcels                  Parcel[]
  reservations             Reservation[]
  tickets                  Ticket[]
  vehicles                 Vehicle[]
  edgeDevices              EdgeDevice[]
  accessPoints             AccessPoint[]
  lprReads                 LprRead[]
  guests                   Guest[]
  guestEvents              GuestEvent[]
  guestAccessUses          GuestAccessUse[]
  guestApprovalRequests    GuestApprovalRequest[]
  accessEvents             AccessEvent[]
  edgeSyncOutbox           EdgeSyncOutboxEntry[]
  edgeDeviceMirror         EdgeDeviceMirror[]
  knowledgeDocs            BuildingKnowledgeDoc[]
  anomalyEvents            AnomalyEvent[]
  lprCameraApLinks         LprCameraAccessPointLink[]
  courierVisits            CourierVisit[]
  paymentSettings          PaymentSettings?
  paymentComponents        PaymentComponent[]
  paymentCharges           PaymentCharge[]
  mt940Imports             Mt940Import[]
  aiEngine                 AiEngineConfig?
  assistantQueryLogs       AssistantQueryLog[]
  // Domofon-połączenia (SIP↔WebRTC bridge, 2026-06-13) — patrz
  // docs/intercom-akuvox-call.md. Za flagą INTERCOM_CALL_ENABLED.
  intercomCallSessions     IntercomCallSession[]
  // 2026-07-29 — grupy kontaktowe lokali (BA) dla ekranu domofonu Akuvox.
  contactGroups            ContactGroup[]
  // 2026-07-30 — Akuvox Directory Sync v2 (docs/akuvox-directory-v2-analysis.md).
  akuvoxDevices            AkuvoxDevice[]
  akuvoxImportTemplates    AkuvoxImportTemplate[]
  // 2026-08-09 — zaproszenia domowników (mieszkaniec → domownik tego samego lokalu).
  householdInvitations     HouseholdInvitation[]

  @@map("buildings")
}

// 2026-07-29 — Grupa kontaktowa lokali (BA panel): np. „Budynek 1",
// „ulica Komfortowa". Lokal należy do maks. jednej grupy (Unit.contactGroupId).
// Użycie: grupowanie kontaktów na ekranie domofonu Akuvox —
//   • E18C UserData.tgz: atrybut Group w userdata.xml (natywne grupy),
//   • R29 Remote Phonebook: format płaski → prefiks nazwy + sortowanie.
model ContactGroup {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  units Unit[]

  @@unique([buildingId, name])
  @@map("contact_groups")
}

// Building knowledge base — repozytorium dokumentów dla LLM RAG.
// Synced do Edge przez tunnel (KNOWLEDGE_UPSERT) gdzie jest chunkowany +
// embedowany (bge-m3) dla semantic search.
//   MESSENGER_CHAT — eksport JSON z Messengera (FB Data Download)
//   UCHWALA        — uchwała zarządu (PDF/DOCX → parsed text)
//   REGULAMIN      — regulamin osiedla
//   KONTAKT        — kontakty serwisowe (CSV / manual entry)
//   INNE           — generic notatka tekstowa
enum BuildingKnowledgeType {
  MESSENGER_CHAT
  UCHWALA
  REGULAMIN
  KONTAKT
  INNE
}

// Building knowledge base — repozytorium dokumentów per budynek dla LLM RAG.
// Każdy doc syncuje się do Edge przez tunnel (KNOWLEDGE_UPSERT) gdzie jest
// chunkowany + embedowany (bge-m3) dla semantic search.
// Pliki binarne (PDF/DOCX/JSON) trafiają tylko na Edge filesystem
// (~/gatelynk-edge/knowledge/<id>.<ext>). Cloud DB trzyma parsedText
// + metadata.
model BuildingKnowledgeDoc {
  id          Int                   @id @default(autoincrement())
  buildingId  Int
  building    Building              @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  type        BuildingKnowledgeType
  title       String
  // Wyekstrahowany tekst (po parsowaniu PDF/DOCX/JSON). Synced do Edge dla RAG.
  parsedText  String                @db.Text
  // Metadata per-type w JSONB:
  //   MESSENGER_CHAT: { participants, threadTitle, messageCount, dateRange }
  //   UCHWALA: { number, date, topic }
  //   REGULAMIN: { sections: [] }
  //   KONTAKT: { role, phone, email, hours }
  metadata    Json?
  // Original file extension (.pdf/.docx/.json). null dla manual entry.
  fileExt     String?
  // Original file size in bytes.
  fileSizeB   Int?
  // Kto wgrał (BuildingAdmin.id z JWT.sub).
  uploadedBy  Int
  uploadedAt  DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  // Soft delete — Edge widzi DELETE i czyści swoje sqlite + filesystem.
  isArchived  Boolean               @default(false)
  archivedAt  DateTime?

  @@index([buildingId, type, uploadedAt(sort: Desc)])
  @@index([buildingId, isArchived])
  @@map("building_knowledge_docs")
}

// ─── EDGE DEVICES ─────────────────────────────────────────────────────────────

model EdgeDevice {
  id         String   @id @default(cuid())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  // EDGE | EDGE_AI
  type String  @default("EDGE")
  name String?

  // Activation
  activationCode          String?   @unique
  activationCodeExpiresAt DateTime?
  isActivated             Boolean   @default(false)
  activatedAt             DateTime?

  // Runtime info (reported by device)
  lastSeenAt  DateTime?
  ipAddress   String?
  version     String?
  machineInfo Json?

  createdAt DateTime @default(now())

  outboxEntries EdgeSyncOutboxEntry[]
  mirrorDevices EdgeDeviceMirror[]

  @@map("edge_devices")
}

// Faza 7.6 — outbox dla Cloud→Edge messaging. Patrz komentarz w migracji
// 20260508130000_add_edge_sync_outbox.
model EdgeSyncOutboxEntry {
  id            String   @id // 8-znakowy random, używany też jako WS message id
  buildingId    Int
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  edgeDeviceId  String?
  edgeDevice    EdgeDevice? @relation(fields: [edgeDeviceId], references: [id], onDelete: Cascade)
  action        String
  payload       Json     @default("{}")
  attempts      Int      @default(0)
  lastAttemptAt DateTime?
  lastError     String?
  deliveredAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime @default(now())

  @@map("edge_sync_outbox")
}

// ─── EDGE DEVICE MIRROR (Faza B-2 wizarda, 2026-05-13) ────────────────────────
// Mirror urządzeń z Edge sqlite (apps/edge/src/devices/device-registry.service).
// Edge wysyła DEVICE_UPSERT/DELETE/SYNC_ALL przez WS tunnel; Cloud upsertuje tu.
//
// **Source of truth = Edge sqlite.** Ta tabela jest tylko mirror-em — pozwala
// Cloud panelowi BA/Integratora wyrenderować listę urządzeń bez gadania
// z każdym Edge na żywo.
//
// `deviceUuid` to UUID urządzenia w Edge sqlite (DeviceRegistryService.saveDevice).
// `edgeDeviceId` to cuid EdgeDevice (= Mac Mini) — który Edge to wystawił.
//
// Backfill (migration 20260513120100): istniejące BuildingIntercom + LprCamera
// są przepisywane do mirror, żeby BA panel nie stracił widoczności do czasu
// pełnego sync po reconnect Edge.
model EdgeDeviceMirror {
  id            Int         @id @default(autoincrement())
  buildingId    Int
  building      Building    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  edgeDeviceId  String?     // cuid EdgeDevice (Cloud Mac Mini) — gdy znany
  edgeDevice    EdgeDevice? @relation(fields: [edgeDeviceId], references: [id], onDelete: SetNull)

  deviceUuid    String      // UUID urządzenia w Edge sqlite
  type          String      // INTERCOM | CAMERA | LPR_CAMERA | ELEVATOR | LIGHTING | SWITCH | KNX_BRIDGE | KNX_OBJECT
  driverId      String?     // z @gatelynk/device-drivers catalog (np. 'akuvox-smartplus')
  config        Json        @default("{}") // pełna kopia configu z Edge sqlite
  // Faza B-4 (2026-05-14) — nazwa wyświetlana w aplikacji mieszkańca / panelu BA.
  // Init z `config.name` przy pierwszym DEVICE_UPSERT, potem nadpisywalna przez
  // BA inline edit. Cloud nigdy nie nadpisuje gdy istniejąca wartość != null
  // (COALESCE w upsert SQL).
  displayLabel    String?
  labelUpdatedBy  String?  // 'edge-init' | 'building-admin' | 'integrator'
  labelUpdatedAt  DateTime?
  lastSyncedAt  DateTime    @default(now()) @updatedAt
  createdAt     DateTime    @default(now())

  @@unique([buildingId, deviceUuid])
  @@index([buildingId, type])
  @@map("edge_device_mirror")
}

// ─── AI ENGINE (FAZA 8.g, 2026-06-03) ────────────────────────────────────────
// First-class device per budynek — zewnętrzny YOLO/Vision service na MacBook
// M1 (lub innej maszynie z GPU). Dotąd URL siedział w `process.env.YOLO_URL`
// — niefajne dla integratora (każda zmiana = ręczne SSH na Edge + restart).
// Teraz: edytowalna konfiguracja per budynek z panelu Integratora, syncowana
// do Edge przez `AI_ENGINE_CONFIG_UPDATE` tunnel command + outbox replay.
//
// MVP założenie: 1 AI Engine per budynek (UNIQUE buildingId). W przyszłości
// można rozszerzyć do N (load split / redundancja).
//
// Permissions cascade — `feat_ai_engine` master nad `feat_fall_detection`,
// `feat_vision_dashboard`, `feat_brand_detection`, `feat_plate_ocr`. Patrz
// `feature-permissions.constants.ts` (hasPermission).
//
// Test connection flow:
//   1. BA/Integrator klika "Testuj połączenie" → POST /ai-engine/test
//   2. Cloud → tunnel AI_ENGINE_TEST → Edge GET healthPath
//   3. Edge → tunnel event AI_ENGINE_TEST_RESULT z {ok, ms, statusCode, error}
//   4. EdgeGateway zapisuje wynik do `lastTest*` kolumn
//   5. Frontend pollu-je GET /ai-engine i odświeża "Ostatni test: X temu, OK Yms"
// FAZA 8.h.25 (2026-06-12) — log pytań do GateLynk AI + ocena integratora.
// Tymczasowy panel: dataset do dostrojenia LLM (ocenione pary Q/A).
model AssistantQueryLog {
  id          Int       @id @default(autoincrement())
  buildingId  Int
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  role        String    // 'RESIDENT' | 'BUILDING_ADMIN'
  userId      Int?
  question    String
  answer      String
  intent      String?
  totalMs     Int?
  model       String?
  smart       Boolean   @default(true)
  ratingOk    Boolean?  // NULL = nieocenione, true = OK, false = NIE OK
  ratedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([buildingId, createdAt(sort: Desc)])
  @@map("assistant_query_logs")
}

model AiEngineConfig {
  id            Int      @id @default(autoincrement())
  buildingId    Int      @unique
  building      Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  url           String
  healthPath    String   @default("/health")
  model         String   @default("yolov8n")
  enabled       Boolean  @default(true)

  // Last test result (set by EdgeGateway on AI_ENGINE_TEST_RESULT event)
  lastTestAt    DateTime?
  lastTestOk    Boolean?
  lastTestMs    Int?
  lastTestErr   String?
  lastTestCode  Int?

  // FAZA 8.h.7 (2026-06-08) — LLM (Ollama) summarizer config.
  // Generuje PL narratives dla notable frames przez VisionLlmSummarizerService.
  // Niezależny enabled flag — można mieć YOLO ON + LLM OFF (oszczędność CPU
  // na MacBooku gdy LLM 14B model jeździ wolno).
  llmUrl          String?
  llmModel        String   @default("qwen2.5:14b")
  llmEnabled      Boolean  @default(true)
  llmLastTestAt   DateTime?
  llmLastTestOk   Boolean?
  llmLastTestMs   Int?
  llmLastTestErr  String?
  llmLastTestCode Int?
  // FAZA 8.h.8 (2026-06-08) — JSON array zainstalowanych modeli Ollama
  // (cache z ostatniego LLM_TEST). UI pokazuje "✓ zainstalowane" vs
  // "⚠ trzeba pobrać" dla wybranych presetów.
  llmAvailableModels Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([buildingId])
  @@map("ai_engines")
}

// ─── ACCESS POINTS ────────────────────────────────────────────────────────────

model AccessPoint {
  id         Int      @id @default(autoincrement())
  buildingId Int
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  label String // "Wejście główne", "Garaż", "Furtka"
  icon  String @default("door") // door | garage | gate | elevator | barrier

  // Edge device reference (LEGACY — used as fallback by Edge when output binding is empty)
  edgeDeviceId String? // EdgeDevice.id — który Edge obsługuje
  deviceId     String // UUID urządzenia na Edge (intercom) — legacy field
  relayIndex   Int // indeks przekaźnika — legacy field

  // Refactor 2026-06-01: binding warstwy 3 (AccessPoint = device output binding).
  // outputDeviceId/outputIndex pozwalają adminowi swobodnie zmieniać, który
  // przekaźnik (np. Hikvision LPR I/O zamiast Akuvox doorIndex 0) otwiera
  // dany punkt dostępu, bez modyfikowania kodu Edge.
  //
  // Backfill: outputDeviceId = deviceId, outputIndex = relayIndex (1:1 dla
  // wszystkich AP sprzed migracji). Nowe AP muszą mieć obie kolumny wypełnione
  // — Edge resolver wpada w fallback (legacy deviceId+relayIndex) gdy nullable.
  outputDeviceId String? // UUID urządzenia (device_config.device_id na Edge)
  outputIndex    Int? // 0/1 dla Akuvox doorIndex, 1..n dla Hikvision I/O
  durationMs     Int     @default(800) // pulse duration ms (Hikvision needs explicit low)
  scope          String  @default("RESIDENT") // PUBLIC | RESIDENT | ADMIN_ONLY

  // 2026-06-02 (FAZA c) — semantyczna kategoria dla grupowania w UI i logiki
  // rules (np. fire_escape ma inny domyślny scope). Wartości w
  // `apps/api/src/access-points/access-points.constants.ts`.
  category  String  @default("MAIN_ENTRY")

  // 2026-07-08 (Nuki smart lock, category=UNIT_DOOR) — AP przypisany do LOKALU.
  // unitId != NULL ⇒ AP widzi WYŁĄCZNIE mieszkaniec tego lokalu (aktywny pivot
  // unit_residents) — filtr w resident endpoints (GET access-points + open).
  // NULL = AP budynkowy (jak dotąd). Gość: UNIT_DOOR NIGDY nie wchodzi w tryb
  // „bez ograniczeń" — tylko jawny wpis w Guest.allowedAccessPoints.
  unitId Int?
  unit   Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guestEvents   GuestEvent[]
  accessEvents  AccessEvent[]
  guestAccessUses GuestAccessUse[]
  schedules     AccessPointSchedule[]
  lprCameraLinks LprCameraAccessPointLink[]
  guestOpenNonces GuestOpenNonce[]
  guestApprovalRequests GuestApprovalRequest[]

  @@unique([buildingId, deviceId, relayIndex])
  @@index([buildingId, unitId])
  @@map("access_points")
}

// 2026-06-02 (FAZA c) — many-to-many między LPR kamerą (mirror.deviceUuid)
// a AccessPoint. Pozwala kamerze wjazdowej i wyjazdowej współdzielić tę samą
// bramę (2 linki direction='IN'/'OUT' do tego samego AP) ALBO 1 kamerze otwierać
// 2 różne bramy (rzadkie, ale dopuszczone).
//
// Edge `HikvisionLprService` przy match plate szuka po (cameraDeviceUuid)
// w `lpr_camera_ap_links` (synced przez tunnel) — fallback do legacy
// `config.linkedAccessPointId` gdy brak linków.
model LprCameraAccessPointLink {
  id                Int          @id @default(autoincrement())
  cameraDeviceUuid  String       // device_uuid z edge_device_mirror (LPR_CAMERA)
  accessPointId     Int
  accessPoint       AccessPoint  @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  // 'IN' (wjazdowa) | 'OUT' (wyjazdowa). Domyślnie IN — legacy backfill.
  direction         String       @default("IN")
  buildingId        Int
  building          Building     @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now())

  @@unique([cameraDeviceUuid, accessPointId])
  @@index([accessPointId])
  @@index([buildingId])
  @@map("lpr_camera_ap_links")
}

// ─── ACCESS POINT SCHEDULES (cron auto-open) ──────────────────────────────────
//
// Refactor 2026-06-01. Każdy AccessPoint może mieć N cron-owanych wyzwoleń.
// Edge `ScheduleService` co minutę skanuje wszystkie enabled, parsuje cron
// expression przez `cron-parser` i odpala `executor.fire(apId, {trigger:
// 'SCHEDULE'})`. Drift > 2 min = nie wykonujemy retroaktywnie (przyjęte
// jako akceptowalne — godzinowe eventy nie są krytyczne).
//
// `lastFiredAt` zapisywane po każdym fire żeby uniknąć podwójnego wystrzału
// w jednej minucie (cron loop running co 60s + okno tolerancji 5s).
model AccessPointSchedule {
  id            Int         @id @default(autoincrement())
  accessPointId Int
  accessPoint   AccessPoint @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  cronExpr      String // standardowy 5-pól cron, np. "0 18 * * *" — wieczór codziennie
  label         String? // human-readable, np. "Otwarcie wieczorne"
  enabled       Boolean     @default(true)
  lastFiredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accessPointId, enabled])
  @@map("access_point_schedules")
}

// ─── STAIRWELLS ───────────────────────────────────────────────────────────────

model Stairwell {
  id         Int                @id @default(autoincrement())
  buildingId Int
  building   Building           @relation(fields: [buildingId], references: [id])
  name       String
  createdAt  DateTime           @default(now())
  units      Unit[]
  intercom   StairwellIntercom?

