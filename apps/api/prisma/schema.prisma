// ─── BUILDING INTERCOMS ───────────────────────────────────────────────────────

model BuildingIntercom {
  id           Int      @id @default(autoincrement())
  buildingId   Int
  building     Building @relation(fields: [buildingId], references: [id])
  name         String // np. "Wejście 1", "Brama główna"
  model        String? // Akuvox model
  ipAddress    String?
  sipServer    String?
  sipAccount   String?
  sipPassword  String?
  edgeDeviceId String? // UUID urządzenia w Edge store (link do fizycznego urządzenia w LAN)
  // ── SIP↔WebRTC call bridge (2026-06-13) — docs/intercom-akuvox-call.md ──
  // Konfiguracja mostu połączeń domofonowych. Wszystko opcjonalne; aktywne
  // tylko gdy bridgeEnabled=true ORAZ env INTERCOM_CALL_ENABLED=true.
  // sipServer/sipAccount/sipPassword (powyżej) = rejestracja Akuvox→Janus.
  // turn* = ICE servers dla strony WebRTC (iOS + Janus). sipPassword/turnPassword
  // są filtrowane przez EdgeGateway.sanitizeDeviceConfig przed zapisem mirror-a.
  sipDomain     String? // domena/registrar SIP gdy inna niż IP Edge
  turnUrl       String? // np. turn:turn.gatelynk.com:3478
  turnUsername  String?
  turnPassword  String?
  bridgeEnabled Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 2026-07-30 — Akuvox Directory Sync v2: urządzenie katalogowe może linkować
  // do istniejącego rekordu SIP/bridge (opcjonalnie).
  akuvoxDevices AkuvoxDevice[]

  @@map("building_intercoms")
