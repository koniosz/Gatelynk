# GateLynk Cloud API URL
CLOUD_URL=https://api.gatelynk.pl

# Local HTTP port (for admin/setup UI)
PORT=4000

# Path to encrypted token store (defaults to ~/.gatelynk-edge/store.db)
# In Docker: ustaw na /data/store.db i zamontuj volume /data
STORE_PATH=

# Stable machine identifier — REQUIRED in Docker.
# Ustaw raz i nie zmieniaj — używany do derywacji klucza szyfrowania tokenów.
# Zmiana = utrata tokenu = wymagana ponowna aktywacja.
# Przykład: synology-gatelynk-edge-001
MACHINE_ID=

# Log level: debug | info | warn | error
LOG_LEVEL=info
