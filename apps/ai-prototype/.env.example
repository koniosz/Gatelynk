# Skopiuj do `.env` i dostosuj. Aplikacja czyta env vars z OS,
# więc albo `source .env` przed uruchomieniem, albo uvicorn-em
# z --env-file (uvicorn natively nie wspiera, użyj `python-dotenv` lub
# wrapper-a w shell-u).

# PostgreSQL — connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gatelynk_ai

# Ollama — lokalny daemon
OLLAMA_URL=http://localhost:11434

# Model do intent classification. Polecam qwen2.5:14b (multilingual, JSON-able)
# lub qwen2.5:7b dla wolniejszego sprzętu.
OLLAMA_MODEL=qwen2.5:14b

# Timeout pojedynczego wywołania LLM (sekundy). Intent JSON to ~50 tokenów,
# 15s wystarcza nawet na cold-start.
OLLAMA_TIMEOUT_S=15

# Logowanie. DEBUG dla rozwoju, INFO dla produkcji.
LOG_LEVEL=INFO

# Max długość pytania (chars). Sanity check przed wysyłką do LLM.
MAX_QUESTION_CHARS=500
