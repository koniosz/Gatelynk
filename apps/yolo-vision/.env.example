# yolo-vision config
# Path to YOLO weights — yolov8s.pt is downloaded automatically by ultralytics
# on first inference (~22MB into ~/.cache/ultralytics/) if not present locally.
MODEL_PATH=yolov8s.pt

# HTTP listen port. Different from Ollama (11434). Edge POSTs to this.
PORT=11500

# Bind address. 0.0.0.0 so LAN clients (Edge on 192.168.1.127) can reach us.
HOST=0.0.0.0

# Confidence threshold for detections (0..1). 0.25 is YOLO default.
CONF_THRESHOLD=0.25

# Max image dim for inference. Bigger = slower, smaller = less accurate.
# 640 is YOLO default and what the model was trained on. 1280 for very small
# objects, 320 for 2x speedup if your scene is mostly large foreground.
IMG_SIZE=640

# Device: 'mps' (Apple Metal — M1/M2/M3), 'cuda', 'cpu', 'auto'.
# 'auto' lets the detector pick (prefers MPS on Apple Silicon).
DEVICE=auto

# Snapshot fetch timeout in seconds — for /detect with image_url+auth.
SNAPSHOT_TIMEOUT=8
