# GateLynk dev stack — Mac Mini (Tailscale 100.90.244.90).
# Skopiuj jako `.env` i uzupełnij sekrety. NIGDY nie commituj `.env`.

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=gatelynk
POSTGRES_USER=gatelynk
# Wymagane. Wygeneruj np. `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# ── API ─────────────────────────────────────────────────────────────────────
# JWT_SECRET = ten sam co Edge ma już zapisany w SQLite (patrz historia
# konwersacji). W dev to "dev-secret-change-in-prod"; po przeniesieniu na
# prod wygeneruj nowy: `openssl rand -hex 32` i re-aktywuj wszystkie Edge'y.
JWT_SECRET=dev-secret-change-in-prod
JWT_EXPIRES_IN=7d

# Adres pod którym Web będzie dostępne — używany do CORS allow-list w API.
FRONTEND_URL=http://100.90.244.90:3001

# `development` w Joi schema zezwala na 16+ znaków JWT_SECRET. `production`
# wymusza 32+. Trzymaj `development` dopóki nie wygenerujesz mocnego sekretu.
NODE_ENV=development

# ── Email (Resend) — opcjonalne ─────────────────────────────────────────────
# Bez tego maile się nie wyślą, ale aplikacja startuje OK.
RESEND_API_KEY=

# ── Apple Push Notifications — opcjonalne ──────────────────────────────────
# Plik .p8 wgraj do `infra/dev/secrets/AuthKey.p8` (mountowany jako
# `/secrets/AuthKey.p8` w kontenerze).
APN_KEY_ID=
APN_TEAM_ID=
APN_KEY_PATH=/secrets/AuthKey.p8
APN_BUNDLE_ID=com.gatelynk.app

# ── Web ─────────────────────────────────────────────────────────────────────
# URL-e kierowane przez przeglądarkę użytkownika do API. Inline'owane do JS
# w trakcie buildu Web (`NEXT_PUBLIC_*`), więc każda zmiana = rebuild Web.
NEXT_PUBLIC_API_URL=http://100.90.244.90:3000/api
