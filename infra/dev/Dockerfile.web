# syntax=docker/dockerfile:1.7

# Multi-stage build for @gatelynk/web (Next.js 16, monorepo).
#
# Standalone output (`output: 'standalone'` w next.config.ts) tnie image-a
# bo Next sam śledzi zależności runtime i kopiuje tylko to czego naprawdę
# potrzebuje server.js. Dla monorepo dodatkowo `outputFileTracingRoot`
# pokazuje na root repo, żeby trace objął workspace deps (@gatelynk/device-drivers).

# ─── base ───────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

# ─── deps ───────────────────────────────────────────────────────────────────
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY apps/edge/package.json apps/edge/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY packages/device-drivers/package.json packages/device-drivers/
RUN pnpm install --frozen-lockfile

# ─── build ──────────────────────────────────────────────────────────────────
FROM deps AS build
# `NEXT_PUBLIC_*` zmienne MUSZĄ być znane w czasie buildu — Next inline'uje je
# do JS-a jako string literal. Zmiana adresu API po budowie = nowy build.
# Default tu (localhost:3000/api) jest tylko fallbackiem dla lokalnego buildu;
# w docker compose przekazujemy pełny http://<host>:3000/api.
ARG NEXT_PUBLIC_API_URL=http://localhost:3000/api
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1
COPY apps/web apps/web/
COPY packages packages/
RUN pnpm --filter @gatelynk/web run build

# ─── runtime ────────────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Standalone output zachowuje strukturę monorepo (apps/web, node_modules,
# packages…). server.js leży pod apps/web/server.js. Próba wystartowania z
# dowolnej innej ścieżki = ENOENT na node_modules.
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
