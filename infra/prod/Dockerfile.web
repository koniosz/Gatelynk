# syntax=docker/dockerfile:1.7

# Production Dockerfile for @gatelynk/web on Fly.io.
#
# Praktycznie identyczny z `infra/dev/Dockerfile.web`. Web nie potrzebuje
# Tailscale — łączy się z API przez publiczny `https://api.gatelynk.com`.
# Zostawiamy osobny plik prod/ zamiast `..` na dev Dockerfile, żeby zmiany
# w dev nie potrafiły zepsuć produkcji niechcący.
#
# NEXT_PUBLIC_API_URL wstrzykujemy przez --build-arg w `fly deploy`, bo Next
# zamraża go do JS-a w czasie buildu. Zmiana = nowy deploy.

# ─── base ───────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

# ─── deps ───────────────────────────────────────────────────────────────────
FROM base AS deps
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY apps/edge/package.json apps/edge/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY packages/device-drivers/package.json packages/device-drivers/
RUN pnpm install --frozen-lockfile

# ─── build ──────────────────────────────────────────────────────────────────
FROM deps AS build
ARG NEXT_PUBLIC_API_URL=https://api.gatelynk.com/api
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1
COPY apps/web apps/web/
COPY packages packages/
RUN pnpm --filter @gatelynk/web run build

# ─── runtime ────────────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "apps/web/server.js"]
