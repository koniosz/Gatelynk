# syntax=docker/dockerfile:1.7

# Production Dockerfile for @gatelynk/api on Fly.io.
#
# Różni się od `infra/dev/Dockerfile.api` tylko w runtime stage:
#   • dokłada tailscaled binarkę (userspace networking — Fly Firecracker
#     microVMs nie mają /dev/net/tun) + HTTP proxy na :1055
#   • używa `entrypoint-api.sh` który podnosi tailscaled przed `node`
#
# Faza 7.1 (2026-05-08) — naprawa drift-u Prismy 5.22 vs 7.5: usunięto
# `@prisma/adapter-pg` z dependencies (production app i tak używa standardowego
# PrismaClient bez adapter-a), `pnpm install` nie ściąga już duplikatu @7.5.
# Dlatego workaround `rm -rf @prisma/client` z poprzednich wersji nie jest
# już potrzebny.

# ─── base ───────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates dumb-init curl iptables \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

# ─── deps ───────────────────────────────────────────────────────────────────
FROM base AS deps
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/api/package.json apps/api/
COPY apps/edge/package.json apps/edge/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY packages/device-drivers/package.json packages/device-drivers/
RUN pnpm install --frozen-lockfile

# ─── build ──────────────────────────────────────────────────────────────────
FROM deps AS build
# Faza B-3: rootowy tsconfig.base.json — wymagany przez `packages/device-drivers/tsconfig.json`
# (extends `../../tsconfig.base.json`). Bez tego tsc fail z error TS5083.
COPY tsconfig.base.json ./
COPY apps/api apps/api/
COPY packages packages/
RUN cd apps/api && pnpm exec prisma generate
# Faza B-3 (2026-05-14): API zaczęło używać `@gatelynk/device-drivers`.
# Workspace dep musi mieć zbudowany `dist/` ZANIM API się zbuduje, bo
# `package.json#main` wskazuje na `./dist/index.js` (Node wymaga JS w runtime).
# Bezpośrednie `tsc` z root `node_modules/.bin/` — omijamy `pnpm run build`,
# żeby uniknąć „node_modules missing" w monorepo (deps stage zrobił install
# przed `COPY packages`).
RUN cd packages/device-drivers && ../../node_modules/.bin/tsc
RUN pnpm --filter @gatelynk/api run build

# ─── runtime ────────────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production

# ── Tailscale (userspace) ────────────────────────────────────────────────────
# Pinujemy wersję żeby build był reproducible. Latest stable na 2026-04: 1.82.
# Repository setup: dodaje signing key + apt source z pakages.tailscale.com.
ARG TAILSCALE_VERSION=1.82.0
RUN curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg \
      -o /usr/share/keyrings/tailscale-archive-keyring.gpg \
 && curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.tailscale-keyring.list \
      -o /etc/apt/sources.list.d/tailscale.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      "tailscale=${TAILSCALE_VERSION}" \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/package.json ./
COPY --from=build /app/apps/api/package.json apps/api/
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/api/prisma apps/api/prisma
COPY --from=build /app/packages packages
COPY --from=build /app/node_modules node_modules
COPY --from=build /app/apps/api/node_modules apps/api/node_modules
COPY infra/prod/entrypoint-api.sh /usr/local/bin/entrypoint-api.sh
RUN chmod +x /usr/local/bin/entrypoint-api.sh

WORKDIR /app/apps/api
EXPOSE 3000
ENTRYPOINT ["dumb-init", "--"]
CMD ["/usr/local/bin/entrypoint-api.sh"]
